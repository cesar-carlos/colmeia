# -----------------------------------------------------------------------------
# Staging validation overlay (no secrets — safe to commit).
#
# Not loaded automatically. Merge into assets/env/local.env (gitignored), pass
# --dart-define per key, or set process env before `flutter test` / app run.
#
# Prerequisites (hub staging, plug_server ops):
#   - SOCKET_RELAY_BATCH_ENABLED=true on the hub (v1 shipped 2026-05-28)
#   - SOCKET_CONSUMER_ROLES includes client; sticky sessions on /socket.io/
# See assets/env/.env.example and docs/plug_server_docs_index_for_colmeia.md
# ("Staging validation checklist").
# -----------------------------------------------------------------------------

# Hub relay JSON-RPC batch (ADR 0008). Same as production default.env;
# keep here for staging-only overlays merged into local.env.
SOCKET_RELAY_BATCH_ENABLED=true

# Staging pilots (hub + DB headroom required; compare with E2E off/on).
AGENT_SQL_OVERVIEW_BATCH_MAX_PARALLEL_READ_ONLY_ITEMS=2
# Roll back to false to restore per-bucket unary executeSql on cold cache.
AGENT_QUERY_FACTS_BUCKET_USE_EXECUTE_BATCH=true
# One merged sql.executeBatch per agent on overview — validate via E2E first:
#   flutter test test/integration/e2e/overview_batch_loader_e2e_test.dart --concurrency=1
AGENT_SQL_OVERVIEW_MERGE_SQL_BATCHES_PER_TARGET=false
# Mirrors production default.env merge-all tuning.
AGENT_QUERY_MERGE_ALL_CONCURRENCY=4
SALES_LIVE_MAP_MERGE_WAVE_SIZE=4
AGENT_SQL_SALES_LIVE_MAP_MERGE_SQL_BATCHES_PER_TARGET=true

# Per-phase server timings on every response (~120 B). Staging diagnostics only.
SOCKET_REQUEST_SERVER_TIMINGS_ENABLED=true

# Keep false until hub echoes client JSON-RPC id on fast-path — see
# docs/server_adjustments/relay_unary_fast_path.md
# SOCKET_RELAY_FAST_PATH_ENABLED=true
