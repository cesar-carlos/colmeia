# Bundled defaults: real HTTP API (see injector_core: ApiAuthRemoteDataSource).
# Override: --dart-define=KEY=value (wins over dotenv), or optional assets/env/local.env (merged after this file).
# For offline dev with FakeAuthRemoteDataSource: set USE_FAKE_BACKEND=true in local.env (add asset in pubspec.yaml).
API_BASE_URL=https://plug-server.se7esistemassinop.com.br/api/v1
USE_FAKE_BACKEND=false
SENTRY_DSN=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.2

# ----- Agent bridge & socket -----
#
# REST: bridge commands go through POST .../agents/commands.
# Socket: bridge commands go through `agents:command` over `/consumers`; relay
# and presence are enabled automatically by AGENT_BRIDGE_TRANSPORT=socket.
#
# If the hub rejects `role=client` on `/consumers`, socket bridge calls fail
# until the server applies `SOCKET_CONSUMER_ROLES` including `client` + restart.
# Relay/presence overrides: see assets/env/.env.example checklist.
AGENT_BRIDGE_TRANSPORT=rest
# SOCKET_RELAY_ENABLED=false
# SOCKET_PRESENCE_LISTENER_ENABLED=false

# Mobile-friendly defaults. Kept commented so the in-code defaults
# stay authoritative; uncomment to override per build.
# SOCKET_NAMESPACE=/consumers
# SOCKET_RECONNECT_ATTEMPTS=5
# SOCKET_RECONNECT_INITIAL_DELAY_MS=1000
# SOCKET_RECONNECT_MAX_DELAY_MS=30000
# SOCKET_REQUEST_TIMEOUT_MS=15000
# SOCKET_HANDSHAKE_TIMEOUT_MS=10000
# SOCKET_WARM_UP_AFTER_LOGIN=true
# SOCKET_MAX_INFLIGHT_PER_AGENT=8
# SOCKET_COALESCING_ENABLED=true
# SOCKET_TIMEOUT_ADAPTIVE_ENABLED=false
# SOCKET_BATCH_ENABLED=false
# SOCKET_BATCH_WINDOW_MS=8
# SOCKET_BATCH_MAX_SIZE=32
# SOCKET_BATCH_MIN_SIZE=1
# PR-K: `connection:ready` decoder. `compat` (default) auto-detects
# PayloadFrame ↔ raw JSON during the migration window the hub is
# closing on 2026-09-30. Set to `payload_frame_only` after the hub
# stops emitting raw JSON.
# SOCKET_CONNECTION_READY_COMPAT_MODE=compat
# Relay tuning.
# SOCKET_RELAY_REQUEST_TIMEOUT_MS=30000
# SOCKET_RELAY_CONVERSATION_START_TIMEOUT_MS=10000
# SOCKET_RELAY_CONVERSATION_END_TIMEOUT_MS=5000
# SOCKET_RELAY_PAYLOAD_FRAME_COMPRESSION=default
# Streaming flow control via relay:rpc.stream.pull credits.
# SOCKET_RELAY_STREAM_INITIAL_WINDOW=32
# SOCKET_RELAY_STREAM_REFILL_THRESHOLD=16

# ----- PayloadFrame signing (HMAC-SHA256) -----
# Fill ONLY if the hub itself runs with PAYLOAD_SIGN_OUTBOUND=true and
# PAYLOAD_SIGNING_KEY configured. The key MUST match the hub's
# byte-for-byte (UTF-8). Default empty = unsigned mode (the hub also
# accepts unsigned frames when itself unconfigured).
# SOCKET_PAYLOAD_SIGNING_KEY=
# SOCKET_PAYLOAD_SIGNING_KEY_ID=
# Strict inbound: when `true` and the signing key is set, the codec
# rejects unsigned inbound frames with `signature_required`. Defence
# in depth — only enable when the hub is also signing outbound.
# SOCKET_PAYLOAD_REQUIRE_SIGNATURE=false
