# Bundled defaults: real HTTP API (see injector_core: ApiAuthRemoteDataSource).
# Override: --dart-define=KEY=value (wins over dotenv), or optional assets/env/local.env (merged after this file).
# For offline dev with FakeAuthRemoteDataSource, prefer:
#   --dart-define=USE_FAKE_BACKEND=true
API_BASE_URL=https://plug-server.se7esistemassinop.com.br/api/v1
USE_FAKE_BACKEND=false
SENTRY_DSN=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.2
AUTO_UPDATE_FEED_URL=
# Optional HERE Geocoding & Search API key. Leave empty by default. The web
# client must not call HERE directly in this phase.
HERE_GEOCODING_API_KEY=

# ----- Agent bridge & socket -----
#
# REST: bridge commands go through POST .../agents/commands.
# Socket: bridge commands go through `agents:command` over `/consumers`; relay
# and presence are enabled automatically by AGENT_BRIDGE_TRANSPORT=socket.
#
# If the hub rejects `role=client` on `/consumers`, socket bridge calls fail
# until the server applies `SOCKET_CONSUMER_ROLES` including `client` + restart.
# Relay/presence overrides: see assets/env/.env.example checklist.
AGENT_BRIDGE_TRANSPORT=socket
# Full socket (Modo B): agents:command + relay + presence. Implies relay;
# SOCKET_RELAY_ENABLED is optional when transport=socket.
# Requires hub SOCKET_CONSUMER_ROLES=client and sticky sessions.
SOCKET_WARM_UP_AFTER_LOGIN=true
SOCKET_BATCH_ENABLED=true
SOCKET_TIMEOUT_ADAPTIVE_ENABLED=true
# Per-agent agents:command ceiling (hub SOCKET_REST_AGENT_MAX_INFLIGHT=32).
SOCKET_MAX_INFLIGHT_PER_AGENT=8
SOCKET_RECONNECT_ATTEMPTS=8
SOCKET_MAX_INFLIGHT_WAITERS_PER_AGENT=16
SOCKET_MAX_INFLIGHT_ACQUIRE_WAIT_MS=5000
# Cap streaming SQL rows materialised in memory (0 in code = unlimited).
# Lower if OOM on large relay reports; raise only after E2E on target devices.
SOCKET_STREAM_SQL_COLLECTOR_MAX_BUFFERED_ROWS=250000
# Relay JSON-RPC batch (`relay:rpc.request.batch`). Hub v1 shipped 2026-05-28;
# E2E validated before production default (see assets/env/.env.example).
SOCKET_RELAY_BATCH_ENABLED=true
#
# Modo B Agent SQL (conservative vs hub limits — tune via local.env one key at a time).
AGENT_SQL_CACHE_TTL_MS=5000
AGENT_SQL_CATALOG_CACHE_TTL_MS=30000
AGENT_SQL_PARSE_ISOLATE_ROW_THRESHOLD=2000
AGENT_SQL_RELAY_STREAMING_MAX_CONCURRENT_PER_AGENT=4
AGENT_SQL_REST_MAX_INFLIGHT_PER_AGENT=8
AGENT_SQL_OVERVIEW_BATCH_MAX_PARALLEL_READ_ONLY_ITEMS=4
# Opt-in: one sql.executeBatch per agent on overview (fewer relay round-trips).
# Keep false in production until E2E sign-off:
#   flutter test test/integration/e2e/overview_batch_loader_e2e_test.dart --concurrency=1
# Enable on staging via assets/env/staging.env after comparator passes.
AGENT_SQL_OVERVIEW_MERGE_SQL_BATCHES_PER_TARGET=false
AGENT_QUERY_MERGE_ALL_CONCURRENCY=8
AGENT_QUERY_FACTS_PREFETCH_ENABLED=true
# 0 = mirror SOCKET_MAX_INFLIGHT_PER_AGENT (8) for sales map mergeAll waves.
SALES_LIVE_MAP_MERGE_WAVE_SIZE=0
# Sales map period/catalog SQL bridge timeout (ms). Unset = medium tier (180000).
# Examples (copy one line into local.env — tune one key per A/B run):
# SALES_LIVE_MAP_BRIDGE_TIMEOUT_MS=180000
# SALES_LIVE_MAP_BRIDGE_TIMEOUT_MS=240000
# SOCKET_PRESENCE_LISTENER_ENABLED=false

# ----- Agent SQL caches and timeouts (override via local.env / --dart-define) -----
# In-memory LRU cap for SUCCESS-only Agent SQL results.
# AGENT_SQL_CACHE_MAX_SIZE=500
# Per-call bridge timeouts (ms). Three tiers picked by repository
# (standard / medium / long).
# AGENT_SQL_BRIDGE_TIMEOUT_MS=120000
# AGENT_SQL_BRIDGE_MEDIUM_TIMEOUT_MS=180000
# AGENT_SQL_BRIDGE_LONG_TIMEOUT_MS=240000

# Optional relay datasource switch. AGENT_BRIDGE_TRANSPORT=socket already
# enables relay implicitly; flip this only for REST + relay experiments.
# SOCKET_RELAY_ENABLED=false
# Hub opt-in: relay unary fast-path (skips relay:rpc.accepted on unary).
# Keep false until the hub fix described in
# docs/server_adjustments/relay_unary_fast_path.md ships.
# SOCKET_RELAY_FAST_PATH_ENABLED=false
# Hub opt-in: per-phase server-side timings appended to every response.
# Cheap (~120 B/response) but extra noise — staging/E2E diagnostics only.
# Production baseline: false. Staging overlay: assets/env/staging.env
# SOCKET_REQUEST_SERVER_TIMINGS_ENABLED=false

# Mobile-friendly defaults. Uncomment to override per build.
# SOCKET_NAMESPACE=/consumers
# SOCKET_RECONNECT_INITIAL_DELAY_MS=1000
# SOCKET_RECONNECT_MAX_DELAY_MS=30000
# SOCKET_REQUEST_TIMEOUT_MS=15000
# SOCKET_HANDSHAKE_TIMEOUT_MS=10000
# SOCKET_MAX_INFLIGHT_WAITERS_PER_AGENT=0
# SOCKET_MAX_INFLIGHT_ACQUIRE_WAIT_MS=0
# SOCKET_STREAM_SQL_COLLECTOR_MAX_BUFFERED_ROWS=0
# SOCKET_COALESCING_ENABLED=true
# SOCKET_BATCH_WINDOW_MS=8
# SOCKET_BATCH_MAX_SIZE=32
# SOCKET_BATCH_MIN_SIZE=1
# PR-K: `connection:ready` decoder. `payload_frame_only` is the default
# current hub contract. Set `compat` only as a migration override for older
# hubs that still emit raw JSON; `raw_json_only` is legacy-only.
# SOCKET_CONNECTION_READY_COMPAT_MODE=payload_frame_only
# Relay tuning.
# SOCKET_RELAY_REQUEST_TIMEOUT_MS=30000
# SOCKET_RELAY_CONVERSATION_START_TIMEOUT_MS=10000
# SOCKET_RELAY_CONVERSATION_END_TIMEOUT_MS=5000
# SOCKET_RELAY_PAYLOAD_FRAME_COMPRESSION=default
# Streaming flow control via relay:rpc.stream.pull credits.
# SOCKET_RELAY_STREAM_INITIAL_WINDOW=32
# SOCKET_RELAY_STREAM_REFILL_THRESHOLD=16
# Staging pilots (merge batches, parallel items, server timings):
# assets/env/staging.env — hub must also enable relay batch on deployment.
# SOCKET_CONNECTION_POOL_SIZE=1
# AGENT_QUERY_TRANSPORT_POLICY=legacy
# Legacy-only: accept raw JSON `client:agent.profile.updated` from older hubs.
# Current hub contract is PayloadFrame.
# SOCKET_PROFILE_UPDATED_LEGACY_RAW_JSON_ENABLED=false

# ----- PayloadFrame signing (HMAC-SHA256) -----
# Fill ONLY if the hub itself runs with PAYLOAD_SIGN_OUTBOUND=true and
# PAYLOAD_SIGNING_KEY configured. The key MUST match the hub's
# byte-for-byte (UTF-8). Default empty = unsigned mode (the hub also
# accepts unsigned frames when itself unconfigured).
# SOCKET_PAYLOAD_SIGNING_KEY=
# SOCKET_PAYLOAD_SIGNING_KEY_ID=
# Strict inbound: when `true` and the signing key is set, the codec
# rejects unsigned inbound frames with `signature_required`. Defence
# in depth — only enable when the hub is also signing outbound.
# SOCKET_PAYLOAD_REQUIRE_SIGNATURE=false
# Worker isolates for PayloadFrameCodec (gzip / jsonDecode). Set to `false`
# to disable all isolate offload (kill switch).
# SOCKET_PAYLOAD_WORKER_ISOLATES_ENABLED=true
# SOCKET_PAYLOAD_GZIP_DECODE_ISOLATE_THRESHOLD_BYTES=16384
# SOCKET_PAYLOAD_GZIP_ENCODE_ISOLATE_THRESHOLD_BYTES=65536
# SOCKET_PAYLOAD_JSON_DECODE_ISOLATE_THRESHOLD_BYTES=262144

# ----- E2E (integration tests only) -----
# Do not put real credentials in default.env. Use assets/env/local.env for
# local-only test runs, process environment, or --dart-define.
# E2E_AGENT_ID=
# E2E_CLIENT_TOKEN=
# E2E_CLIENT_EMAIL=
# E2E_CLIENT_PASSWORD=
# E2E_DISABLE_RELAY_DISPATCH=false
