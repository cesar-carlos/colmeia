# -----------------------------------------------------------------------------
# Optional: copy this file to assets/env/local.env and add the asset to
# pubspec.yaml under flutter: assets: (see tool/setup_local_env.py).
# Or run the VS Code task "Colmeia: setup local env".
# -----------------------------------------------------------------------------
#
# Security
# - Anything in assets/ is bundled into the app binary; treat it as readable.
# - Do not put production secrets in default.env or local.env.
# - Prefer --dart-define for CI/release and for sensitive values.
#
# Precedence
# - Non-empty --dart-define wins, then dotenv (default.env + optional local.env),
#   then code defaults.
#
# local.env merge parser (app-only)
# - default.env uses the full flutter_dotenv parser.
# - local.env is merged with a small parser: one KEY=value per line, optional
#   # comments, no export keyword, no $VAR interpolation — keep values simple.
# -----------------------------------------------------------------------------
# Defaults below match assets/env/default.env: real API, no fake backend.
# To use the in-memory fake backend locally, copy to local.env and set:
#   USE_FAKE_BACKEND=true
# (and list assets/env/local.env under flutter: assets: in pubspec.yaml).

API_BASE_URL=https://plug-server.se7esistemassinop.com.br/api/v1
USE_FAKE_BACKEND=false
SENTRY_DSN=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.2

# Integration / e2e: agent bridge + optional client-auth (see AppEnvironment).
# Prefer --dart-define for CI. Do not commit real passwords or production tokens.
E2E_AGENT_ID=
E2E_CLIENT_TOKEN=
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
