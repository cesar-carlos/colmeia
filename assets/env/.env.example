# -----------------------------------------------------------------------------
# Optional local reference. Prefer --dart-define for app runtime overrides.
# If you copy this file to assets/env/local.env, keep real secrets commented
# out and only add that file to pubspec.yaml in an uncommitted local change.
# -----------------------------------------------------------------------------
#
# Security
# - Anything in assets/ is bundled into the app binary; treat it as readable.
# - Do not put production secrets in default.env or local.env.
# - Prefer --dart-define for CI/release and for sensitive values.
#
# Precedence
# - Non-empty --dart-define wins, then dotenv (default.env + optional local.env),
#   then code defaults.
#
# local.env merge parser (app-only)
# - default.env uses the full flutter_dotenv parser.
# - local.env is merged with a small parser: one KEY=value per line, optional
#   # comments, no export keyword, no $VAR interpolation — keep values simple.
# -----------------------------------------------------------------------------
# Defaults below match assets/env/default.env: real API, no fake backend.
# To use the in-memory fake backend locally, prefer:
#   --dart-define=USE_FAKE_BACKEND=true

API_BASE_URL=https://plug-server.se7esistemassinop.com.br/api/v1
USE_FAKE_BACKEND=false
SENTRY_DSN=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.2
#
# Windows auto-update feed (Sparkle appcast XML).
# Keep empty by default for local/dev builds. Release builds should prefer
# --dart-define=AUTO_UPDATE_FEED_URL=... or a root .env.release consumed by
# installer/build_installer.py (.env remains as legacy fallback).
AUTO_UPDATE_FEED_URL=
# Optional HERE Geocoding & Search API key. Safe default is empty.
# Do not expose this key in a web client build; web stays unsupported for
# client-side address geocoding until a proxy/backend exists.
HERE_GEOCODING_API_KEY=

# ----- Agent bridge & socket -----
#
# REST: bridge commands go through POST .../agents/commands.
# Socket (Modo B): bridge commands go through `agents:command` over
# `/consumers`; relay and presence are enabled automatically by
# AGENT_BRIDGE_TRANSPORT=socket (SOCKET_RELAY_ENABLED is optional).
#
# Bundled default.env ships socket (Modo B). To roll back to REST, set
# AGENT_BRIDGE_TRANSPORT=rest in local.env. Socket warm-up/batch below; requires hub
# sticky sessions — see production checklist below.
#
# Hybrid relay-over-REST (commented alternative — copy into local.env):
# AGENT_BRIDGE_TRANSPORT=rest
# SOCKET_RELAY_ENABLED=true
#
# Production checklist before AGENT_BRIDGE_TRANSPORT=socket:
#   1. Hub SOCKET_CONSUMER_ROLES includes `client` + restart.
#   2. nginx upstream sticky session by socket.io / X-Hub-Instance-Id
#      (relay conversations are per-instance — see scaling_and_roadmap.md).
#   3. Hub keeps `SOCKET_CLIENT_AGENT_PROFILE_PUSH_ENABLED=true`
#      (or omitted) so `client:agent.profile.updated` remains active.
#   4. Smoke test handshake. Default SOCKET_CONNECTION_READY_COMPAT_MODE=
#      payload_frame_only expects PayloadFrame; use compat only for older hubs.
#
# ----- Staging validation (relay batch + hub pilots) -----
#
# Production default: SOCKET_RELAY_BATCH_ENABLED=true (assets/env/default.env).
# Committed overlay (no secrets): assets/env/staging.env
# Merge into assets/env/local.env or pass --dart-define per key for A/B.
#
# Prerequisites (hub staging, plug_server ops):
#   1. Hub SOCKET_RELAY_BATCH_ENABLED=true (v1 shipped 2026-05-28)
#   2. SOCKET_CONSUMER_ROLES includes client; sticky /socket.io/ sessions
#   3. Baseline Prometheus 15–30 min before comparing client tuning
#
# Committed staging pilots (merge into local.env or use --dart-define):
#   assets/env/staging.env — relay batch, merge batches/target, parallel=6,
#   server timings. See that file for E2E validation notes.
# SOCKET_RELAY_FAST_PATH_ENABLED=false
#   ^ keep false until hub echoes client JSON-RPC id on fast-path
#
# Staging smoke helper (docs/Features/socket/socket_production_rollout_runbook.md):
#   Hub env: SOCKET_CONSUMER_ROLES=user,admin,client (+ restart after change)
#   Hub env: SOCKET_CLIENT_AGENT_PROFILE_PUSH_ENABLED=true
#   Hub throughput (see plug_server/docs/performance_hub_agent.md):
#     SOCKET_IO_TRANSPORTS=websocket
#     SOCKET_IO_PER_MESSAGE_DEFLATE=false, SOCKET_IO_HTTP_COMPRESSION=false
#     SOCKET_RELAY_MAX_BUFFERED_CHUNKS_PER_REQUEST=512
#   nginx: sticky session on /socket.io/ (ip_hash or cookie affinity upstream)
#   nginx: proxy_http_version 1.1; Upgrade + Connection "upgrade" headers;
#          proxy_read_timeout / proxy_send_timeout ≥ 600s
#   Baseline Prometheus 15–30 min before comparing client tuning.
#   Post-deploy: flutter test test/integration/e2e/ --concurrency=1
#   Optional comparator: python tool/compare_e2e_transports.py --transport both
#   Monitor: no REST fallback latch breadcrumbs; p95 handshake/dispatch from logs.
#   Pre-flip: consecutive REST calls must show stable X-Hub-Instance-Id
#   Post-flip logs: connection:ready decoded; no agents:command over REST
AGENT_BRIDGE_TRANSPORT=rest
SOCKET_WARM_UP_AFTER_LOGIN=true
SOCKET_BATCH_ENABLED=true
SOCKET_TIMEOUT_ADAPTIVE_ENABLED=true
SOCKET_MAX_INFLIGHT_PER_AGENT=8
SOCKET_RECONNECT_ATTEMPTS=8
SOCKET_MAX_INFLIGHT_WAITERS_PER_AGENT=16
SOCKET_MAX_INFLIGHT_ACQUIRE_WAIT_MS=5000
SOCKET_STREAM_SQL_COLLECTOR_MAX_BUFFERED_ROWS=250000
SOCKET_RELAY_BATCH_ENABLED=true
AGENT_SQL_CACHE_TTL_MS=5000
AGENT_SQL_CATALOG_CACHE_TTL_MS=30000
AGENT_SQL_PARSE_ISOLATE_ROW_THRESHOLD=2000
AGENT_SQL_RELAY_STREAMING_MAX_CONCURRENT_PER_AGENT=4
AGENT_SQL_REST_MAX_INFLIGHT_PER_AGENT=8
# Read-only items per overview sql.executeBatch (per-agent parallelism hint).
AGENT_SQL_OVERVIEW_BATCH_MAX_PARALLEL_READ_ONLY_ITEMS=2
# Opt-in overview merge — conservative baseline for new clones (false).
# Bundled default.env uses prod-like true (64-way parallel, merge batches on).
# Staging pilot overlay: assets/env/staging.env (also true after E2E sign-off).
AGENT_SQL_OVERVIEW_MERGE_SQL_BATCHES_PER_TARGET=true
# Across-agent mergeAll parallelism. default.env=4; overview uses its own wave cap.
AGENT_QUERY_MERGE_ALL_CONCURRENCY=4
# Overview across-agent batch wave. default.env=64 (all agents in one wave).
# Set 0 to mirror AGENT_QUERY_MERGE_ALL_CONCURRENCY.
# OVERVIEW_TARGET_WAVE_CONCURRENCY=64
# Parallel closed-bucket loads (default 1 — avoids overlap with overview SQL burst).
AGENT_QUERY_FACTS_BUCKET_LOAD_CONCURRENCY=1
# Cold-cache buckets: sql.executeBatch (max 32 cmds/chunk) vs unary per bucket.
AGENT_QUERY_FACTS_BUCKET_USE_EXECUTE_BATCH=true
# Delay (ms) after overview before fact prefetch (default 2000; 0 = immediate).
AGENT_QUERY_FACTS_PREFETCH_DELAY_MS=2000
AGENT_QUERY_FACTS_PREFETCH_ENABLED=true
# Sales live map across-agent wave. default.env=64 (overview policy; N<=64 in one wave).
# Use 0 to mirror AGENT_QUERY_MERGE_ALL_CONCURRENCY.
SALES_LIVE_MAP_MERGE_WAVE_SIZE=64
# One sql.executeBatch per agent for sales live map (catalog + period sales).
# default.env=true; keep false here until sales live map merge E2E passes.
AGENT_SQL_SALES_LIVE_MAP_MERGE_SQL_BATCHES_PER_TARGET=false
#
# `SOCKET_BATCH_ENABLED` batches JSON-RPC envelopes on `agents:command` only;
# it does not batch `sql.execute` / `sql.executeBatch` relay payloads
# (`relay:rpc.request`).
#
# Modo B overrides (copy into assets/env/local.env for A/B — one key per run).
# AGENT_SQL_CACHE_MAX_SIZE=500
#
# ----- REST / Agent SQL performance (copy into assets/env/local.env) -----
# Bundled default.env keeps commented examples only; prefer local.env for A/B
# tuning. Change one variable at a time; validate with:
#   flutter test test/integration/e2e/ --concurrency=1
# Optional: E2E_LOG_TRANSIENT=1 in process env for hub 503/timeout mapping.
# A/B: change one env line per run; compare suite wall-clock and 503 rate.
#
# Per-call bridge timeouts (ms). Three tiers picked by repository:
# AGENT_SQL_BRIDGE_TIMEOUT_MS=120000
# AGENT_SQL_BRIDGE_MEDIUM_TIMEOUT_MS=180000
# AGENT_SQL_BRIDGE_LONG_TIMEOUT_MS=240000
#
# In-memory LRU for identical Agent SQL (CachingAgentQueriesRepository).
# AGENT_SQL_CACHE_TTL_MS=5000
# AGENT_SQL_CACHE_MAX_SIZE=500
# Longer TTL for read-only catalog SQL (cadastro filial). 0 = use AGENT_SQL_CACHE_TTL_MS.
# AGENT_SQL_CATALOG_CACHE_TTL_MS=30000
# Offload bridge row parsing to a worker isolate when row count >= threshold. 0 disables.
# AGENT_SQL_PARSE_ISOLATE_ROW_THRESHOLD=2000
# Parallel mergeAll wave for across-agent orchestration (default 4).
# AGENT_QUERY_MERGE_ALL_CONCURRENCY=4
# Overview wave (default.env=64; 0 mirrors merge-all concurrency).
# OVERVIEW_TARGET_WAVE_CONCURRENCY=64
# AGENT_QUERY_FACTS_BUCKET_LOAD_CONCURRENCY=1
# AGENT_QUERY_FACTS_PREFETCH_DELAY_MS=2000
# Sales live map across-agent wave; 0 mirrors AGENT_QUERY_MERGE_ALL_CONCURRENCY.
# SALES_LIVE_MAP_MERGE_WAVE_SIZE=0
# Sales map bridge timeout (ms). Unset = AGENT_SQL_BRIDGE_MEDIUM_TIMEOUT_MS (180000).
# Examples (one key per A/B run in local.env):
# SALES_LIVE_MAP_BRIDGE_TIMEOUT_MS=180000
# SALES_LIVE_MAP_BRIDGE_TIMEOUT_MS=240000
#
# Opt-in: AGENT_SQL_OVERVIEW_MERGE_SQL_BATCHES_PER_TARGET (see value above).
# One sql.executeBatch per agent on overview — fewer relay round-trips.
# Production baseline false; enable on staging after E2E:
#   flutter test test/integration/e2e/overview_batch_loader_e2e_test.dart --concurrency=1
# Staging pilot: assets/env/staging.env sets it true.
# Backfill closed fact buckets after overview (disable on low-end devices).
# AGENT_QUERY_FACTS_PREFETCH_ENABLED=true
# Target-resolution cache TTL (ms). Code default 30000; clamp 1000–300000.
# AGENT_QUERY_TARGET_RESOLUTION_CACHE_TTL_MS=30000
#
# ----- Hive-backed dashboard caches -----
#
# Max concurrent REST bridge calls per agentId (RestInflightAgentQueriesRepository).
# Mirrors hub shared rate-limit pressure; default 8 in AppEnvironment.
# AGENT_SQL_REST_MAX_INFLIGHT_PER_AGENT=8
#
# Overview read-only batch parallelism (sql.executeBatch hint to agent).
# Production baseline 2.
# AGENT_SQL_OVERVIEW_BATCH_MAX_PARALLEL_READ_ONLY_ITEMS=2
# SOCKET_NAMESPACE=/consumers
# Default 5 attempts in code; Modo B runbook recommends 8 for mobile builds.
# SOCKET_RECONNECT_ATTEMPTS=8
# SOCKET_RECONNECT_INITIAL_DELAY_MS=1000
# SOCKET_RECONNECT_MAX_DELAY_MS=30000
# SOCKET_REQUEST_TIMEOUT_MS=15000
# SOCKET_HANDSHAKE_TIMEOUT_MS=10000
# When true, the consumer socket pre-connects right after a successful
# login so the first SQL query does not pay the handshake cost.
# (Enabled in bundled default.env — see performance profile above.)
# SOCKET_MAX_INFLIGHT_PER_AGENT=8
# SOCKET_MAX_INFLIGHT_WAITERS_PER_AGENT=16
# SOCKET_MAX_INFLIGHT_ACQUIRE_WAIT_MS=5000
# SOCKET_STREAM_SQL_COLLECTOR_MAX_BUFFERED_ROWS=500000
# SOCKET_COALESCING_ENABLED=true
# SOCKET_BATCH_WINDOW_MS=8
# SOCKET_BATCH_MAX_SIZE=32
# SOCKET_BATCH_MIN_SIZE=1
# PR-K: connection:ready decoder. payload_frame_only (default) | compat |
# raw_json_only. compat is only a migration override for older hubs; raw JSON
# is legacy-only and planned for removal after 2026-09-30.
# SOCKET_CONNECTION_READY_COMPAT_MODE=payload_frame_only
# Relay (relay:*). Optional explicit override for experiments while the main
# transport remains REST; socket transport already enables relay implicitly.
# SOCKET_RELAY_ENABLED=false
# SOCKET_RELAY_REQUEST_TIMEOUT_MS=30000
# SOCKET_RELAY_CONVERSATION_START_TIMEOUT_MS=10000
# SOCKET_RELAY_CONVERSATION_END_TIMEOUT_MS=5000
# default | none | always — controls hub→agent gzip on `relay:rpc.request`.
# `default` mirrors the auto-compression the hub does on its own; switch
# to `always` only when targeting agents that prefer the "always GZIP"
# mode.
# SOCKET_RELAY_PAYLOAD_FRAME_COMPRESSION=default
# Streaming flow control via `relay:rpc.stream.pull` credits.
# SOCKET_RELAY_STREAM_INITIAL_WINDOW=32
# SOCKET_RELAY_STREAM_REFILL_THRESHOLD=16
# Relay JSON-RPC batch (`relay:rpc.request.batch`). Hub v1 shipped 2026-05-28
# (plug_server ADR 0008). Production default: true in assets/env/default.env.
# Override to false for A/B or pre-hub rollout. Not SOCKET_BATCH_ENABLED.
# SOCKET_RELAY_BATCH_ENABLED=true
# Hub opt-in: relay unary fast-path (skips relay:rpc.accepted on unary).
# Keep false until the hub fix described in
# docs/server_adjustments/relay_unary_fast_path.md ships.
# SOCKET_RELAY_FAST_PATH_ENABLED=false
# Hub opt-in: per-phase server-side timings appended to every response.
# Cheap (~120 B/response) but extra noise — staging/E2E diagnostics only.
# Production: false. Staging overlay: assets/env/staging.env
# SOCKET_REQUEST_SERVER_TIMINGS_ENABLED=false
# Experimental multi-socket pool size (1 = single connection, default).
# SOCKET_CONNECTION_POOL_SIZE=1
# Agent SQL transport policy: legacy | auto | prefer_relay
# Roll out `auto` only after capturing socket session baseline (review §7).
# AGENT_QUERY_TRANSPORT_POLICY=legacy
# Realtime presence (`client:agent.profile.updated` push + per-command
# hints). Optional explicit override for REST-mode experiments; socket
# transport already enables it implicitly.
# SOCKET_PRESENCE_LISTENER_ENABLED=false
# Legacy-only profile update shape. Keep false unless testing an older hub
# that still emits `client:agent.profile.updated` as raw JSON instead of
# PayloadFrame.
# SOCKET_PROFILE_UPDATED_LEGACY_RAW_JSON_ENABLED=false
# Outbound HMAC-SHA256 signing of every PayloadFrame. Leave empty when
# the hub is not configured with `PAYLOAD_SIGNING_KEY` (frames go
# unsigned and are accepted). When the hub enables signing, this MUST
# match `PAYLOAD_SIGNING_KEY` byte-for-byte (UTF-8) for verification
# to succeed.
# SOCKET_PAYLOAD_SIGNING_KEY=
# Optional `signature.key_id` propagated with every signed frame.
# Required when the hub is configured with `PAYLOAD_SIGNING_KEY_ID` —
# otherwise the hub rejects the frame with `-32001 invalid_signature`.
# Leave empty for single-key deployments.
# SOCKET_PAYLOAD_SIGNING_KEY_ID=
# Strict inbound mode: when `true` AND a signing key is set, the codec
# rejects unsigned inbound frames with `signature_required`. Defence
# in depth against MITM on transports below TLS — useful only when the
# hub is also running with `PAYLOAD_SIGN_OUTBOUND=true`.
# SOCKET_PAYLOAD_REQUIRE_SIGNATURE=false
#
# Worker isolates for PayloadFrameCodec (gzip encode/decode, large jsonDecode).
# SOCKET_PAYLOAD_WORKER_ISOLATES_ENABLED=true
# SOCKET_PAYLOAD_GZIP_DECODE_ISOLATE_THRESHOLD_BYTES=16384
# SOCKET_PAYLOAD_GZIP_ENCODE_ISOLATE_THRESHOLD_BYTES=65536
# SOCKET_PAYLOAD_JSON_DECODE_ISOLATE_THRESHOLD_BYTES=262144

# ----- E2E (integration tests: test/integration/e2e) -----
#
# Copy keys below into assets/env/local.env (gitignored) or pass
# --dart-define=E2E_AGENT_ID=... etc. Process env also overrides dotenv
# for these names — see e2e_dependency_bootstrap.dart `_processEnvironmentOverrides`.
#
# E2E_AGENT_ID=uuid-do-agente-na-ponte
# E2E_CLIENT_TOKEN=token-cliente-do-agente-json-rpc-nao-e-o-jwt-da-api
# E2E_CLIENT_EMAIL=conta-para-post-client-auth-login
# E2E_CLIENT_PASSWORD=senha-da-conta-de-teste
#
# Optional: set E2E_LOG_TRANSIENT=1 when running E2E to print hub transient
# (HTTP 5xx / transport) mappings from runE2eAppResult to stdout.
#
# Optional: E2E_DISABLE_RELAY_DISPATCH=true skips relay registration in the
# socket stack so `useRelay: true` SQL uses `agents:command` only (see
# AppEnvironment.e2eDisableRelayDispatch). Use if relay E2E hangs against the hub.
# E2E_DISABLE_RELAY_DISPATCH=false
