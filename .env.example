# -----------------------------------------------------------------------------
# Root env (installer build-time only). Gitignored copy: `.env.release`.
# Never commit `.env.release`.
# -----------------------------------------------------------------------------
#
# App runtime (API, Sentry, socket, E2E, …) is NOT loaded from here. Use
# `assets/env/default.env`, optional `assets/env/local.env`, and `--dart-define`
# — see `assets/env/.env.example`.
#
# `installer/build_installer.py` reads AUTO_UPDATE_FEED_URL in order:
#   1. process environment
#   2. file from COLMEIA_RELEASE_ENV_FILE (when set)
#   3. `.env.release`
#
# Forks: replace the URL below with:
#   https://raw.githubusercontent.com/<ORG>/<REPO>/main/appcast.xml
#
# Setup: copy this file to `.env.release` and adjust if needed.

AUTO_UPDATE_FEED_URL=https://raw.githubusercontent.com/cesar-carlos/colmeia/main/appcast.xml
