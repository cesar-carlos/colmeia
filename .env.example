# Optional root `.env` (copy to `.env`, gitignored).
#
# installer/build_installer.py reads AUTO_UPDATE_FEED_URL from here only as a
# legacy fallback — after process env and COLMEIA_RELEASE_ENV_FILE, and before
# `.env.release`. Prefer `.env.release` from `.env.release.example` for release
# builds with the official appcast.
#
# Application runtime configuration (API, Sentry, sockets, E2E, etc.) is not
# loaded from this file. Use bundled `assets/env/default.env`, optional
# `assets/env/local.env`, and `--dart-define` — see `assets/env/.env.example`.

AUTO_UPDATE_FEED_URL=
