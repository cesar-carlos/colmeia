{
    // https://go.microsoft.com/fwlink/?linkid=830387
    // Android: `emulatorId` = id de `flutter emulators` — inicia o AVD se estiver desligado (Dart-Code >= 3.114).
    // `deviceId` = id de `flutter devices` (útil para físico / iOS / Chrome).
    //
    // Canal Socket: ATIVO POR PADRÃO desde 2026-04 (ver
    // `assets/env/default.env`). Todos os perfis abaixo herdam
    // `AGENT_BRIDGE_TRANSPORT=socket` + `SOCKET_RELAY_ENABLED=true` +
    // `SOCKET_PRESENCE_LISTENER_ENABLED=true` do dotenv.
    //
    // Para forçar REST localmente sem editar o repo, crie
    // `assets/env/local.env` com `AGENT_BRIDGE_TRANSPORT=rest`
    // (esse arquivo está em `.gitignore`). O perfil `(force REST)`
    // abaixo faz o mesmo via `--dart-define` para builds one-off.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "colmeia",
            "request": "launch",
            "type": "dart",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (force REST, Android tablet)",
            "request": "launch",
            "type": "dart",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false",
                "--dart-define=AGENT_BRIDGE_TRANSPORT=rest",
                "--dart-define=SOCKET_RELAY_ENABLED=false",
                "--dart-define=SOCKET_PRESENCE_LISTENER_ENABLED=false"
            ]
        },
        {
            "name": "colmeia (Android phone)",
            "request": "launch",
            "type": "dart",
            "emulatorId": "Medium_Phone_API_36",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Xiaomi Wi-Fi)",
            "request": "launch",
            "type": "dart",
            "deviceId": "192.168.3.208:40619",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (iOS Simulator)",
            "request": "launch",
            "type": "dart",
            "deviceId": "iPhone 17",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (profile, Android tablet)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (release, Android tablet)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        }
    ]
}
