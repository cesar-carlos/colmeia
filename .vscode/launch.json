{
    // https://go.microsoft.com/fwlink/?linkid=830387
    // Android: `emulatorId` = id de `flutter emulators` — inicia o AVD se estiver desligado (Dart-Code >= 3.114).
    // `deviceId` = id de `flutter devices` (útil para físico / iOS / Chrome).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "colmeia",
            "request": "launch",
            "type": "dart",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Android phone)",
            "request": "launch",
            "type": "dart",
            "emulatorId": "Medium_Phone_API_36",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Xiaomi Wi-Fi)",
            "request": "launch",
            "type": "dart",
            "deviceId": "192.168.3.208:40619",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (iOS Simulator)",
            "request": "launch",
            "type": "dart",
            "deviceId": "iPhone 17",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (profile, Android tablet)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (release, Android tablet)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "emulatorId": "Pixel_Tablet",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        }
    ]
}
