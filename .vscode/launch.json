{
    // https://go.microsoft.com/fwlink/?linkid=830387
    // Android emulator ids (`emulator-5554`, `emulator-5556`, …) come from `flutter devices` — update if launch fails
    // (e.g. only Pixel Tablet running may use 5554; with phone + tablet, tablet is often the second port).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "colmeia",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Android emulator)",
            "request": "launch",
            "type": "dart",
            "deviceId": "emulator-5554",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Android Pixel Tablet)",
            "request": "launch",
            "type": "dart",
            "deviceId": "emulator-5556",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Xiaomi Wi-Fi)",
            "request": "launch",
            "type": "dart",
            "deviceId": "192.168.3.208:40619",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (iOS Simulator)",
            "request": "launch",
            "type": "dart",
            "deviceId": "iPhone 17",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        },
        {
            "name": "colmeia (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define=USE_FAKE_BACKEND=false"
            ]
        }
    ]
}
