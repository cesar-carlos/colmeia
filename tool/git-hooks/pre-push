#!/usr/bin/env bash
# Pre-push gate: run cheap CI mirrors before updating main / release tags.
# Installed by: python tool/install_git_hooks.py
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

should_check=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/tags/v*.*.*)
      should_check=1
      ;;
  esac
done

if [[ "$should_check" -eq 0 ]]; then
  exit 0
fi

echo "pre-push: running tool/ci_preflight.py --templates-only"
python tool/ci_preflight.py --templates-only
